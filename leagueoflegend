  if(s.kind==="ground"){const d=hyp(x-u.x,y-u.y);if(d>s.range){const n=nd(u,{x,y});x=u.x+n.x*s.range;y=u.y+n.y*s.range}}
  if(s.check&&!s.check(u,x,y)){if(u===G.player)note("범위 안에 적 영웅이 없습니다");return false}
