  j.addEventListener("pointerup",end);j.addEventListener("pointercancel",end);
})();
// 공격 버튼: 누르면 평타 범위와 대상이 보이고, 떼면 공격
(function(){
  const a=$("atk");let id=null;
  a.addEventListener("pointerdown",e=>{e.preventDefault();if(!G.player||paused)return;id=e.pointerId;a.setPointerCapture(id);G.aim={i:"atk",how:"touch",cancel:false};showCancel(true)});
  a.addEventListener("pointermove",e=>{if(e.pointerId!==id||!G.aim)return;G.aim.cancel=overCancel(e);$("cancel").classList.toggle("hot",G.aim.cancel)});
