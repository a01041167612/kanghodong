let mouseDown=0,mmPeek=false;
function worldOf(e){const r=cv.getBoundingClientRect();return toWorld(e.clientX-r.left,e.clientY-r.top)}
function pickTarget(p){
  let best=null,bd=1e9;
  for(const u of G.units){
    if(u.dead||u.team===G.player.team||u.invuln||!u.seen[0]||u.delay>0)continue;
    const d=hyp(u.x-p.x,(u.y-(u.kind==="tower"?25:u.kind==="nexus"?30:u.kind==="champ"?28:u.kind==="minion"?18:0))-p.y);
    if(d<u.r+(u.kind==="minion"?36:28)&&d<bd){bd=d;best=u}
  }
  return best;
}
function command(p){
  const u=G.player;if(!u||u.dead)return;
  const t=pickTarget(p);
  if(t){u.target=t;u.wps=null;u.dest=null}
  else{u.target=null;setDest(u,p.x,p.y)}
}
addEventListener("pointermove",e=>{if(!G||e.pointerType==="touch")return;G.mouse.sx=e.clientX;G.mouse.sy=e.clientY;if(G.aim&&G.aim.how==="mouse"&&(e.buttons&2))G.aim.cancel=true});
cv.addEventListener("pointerdown",e=>{
  if(!G||!G.player||TOUCH||e.pointerType==="touch")return;
  if(G.aim&&G.aim.how==="key"){e.preventDefault();if(e.button===2)cancelAim();else{G.mouse.sx=e.clientX;G.mouse.sy=e.clientY;const p=worldOf(e);G.mouse.x=p.x;G.mouse.y=p.y;commitAim()}return}
  const p=worldOf(e);G.mouse.x=p.x;G.mouse.y=p.y;mouseDown=1;command(p);e.preventDefault();window.focus();
});
addEventListener("pointerup",()=>{mouseDown=0});
cv.addEventListener("contextmenu",e=>e.preventDefault());
$("app").addEventListener("contextmenu",e=>e.preventDefault());
const KEYS={KeyQ:0,KeyW:1,KeyE:2,KeyR:3};
addEventListener("keydown",e=>{
  if(!G||!G.player||G.over)return;
  if(e.code==="Tab"){e.preventDefault();showScore(false);return}
  if(e.code==="Escape"){e.preventDefault();if(G.aim){cancelAim();return}if(!$("shop").hidden)$("shop").hidden=true;else if(!$("score").hidden)$("score").hidden=true;else setPause(!paused);return}
  if(paused||e.repeat)return;
  if(e.code in KEYS&&(e.shiftKey||e.ctrlKey)){e.preventDefault();rankUp(G.player,KEYS[e.code]);return}
  if(e.code in KEYS){G.aim={i:KEYS[e.code],how:"key"};e.preventDefault()}
  else if(e.code==="KeyD")doSummon(0);
  else if(e.code==="KeyF")doSummon(1);
  else if(e.code==="KeyB")doRecall();
  else if(e.code==="KeyP"){$("shop").hidden?openShop():$("shop").hidden=true}
  else if(e.code==="KeyS"){const u=G.player;u.target=null;u.dest=null;u.wps=null}
  else if(e.code==="KeyA"){G.aim={i:"atk",how:"key"}}
});
addEventListener("keyup",e=>{
  if(!G||!G.player)return;
  if(e.code==="Tab"&&!G.over){$("score").hidden=true;return}
  if(G.aim&&G.aim.how==="key"&&((e.code in KEYS&&G.aim.i===KEYS[e.code])||(e.code==="KeyA"&&G.aim.i==="atk")))commitAim();
});
function castPlayer(i,x,y){
  const u=G.player,s=u.def.skills[i];
  if(!u.rank[i]){note(canRank(u,i)?`아직 배우지 않은 스킬입니다. ${TOUCH?"버튼의 +":"Shift+"+"QWER"[i]}로 배우세요`:i===3?"궁극기는 6레벨부터 배울 수 있습니다":"아직 배우지 않은 스킬입니다");return}
  if(u.cd[i]>0)return;
  if(u.mp<s.mp){note("마나가 부족합니다");return}
  tryCast(u,i,x,y);
}
function nearestAny(u,x,y,r){
  let b=null,bs=1e9;
  for(const o of G.units){
    if(o.dead||o.team===u.team||o.invuln||!o.seen[0]||o.delay>0)continue;
    const d=hyp(o.x-x,o.y-y);if(d>r+o.r)continue;
    const sc=d-(o.kind==="champ"?260:0)-(o.kind==="minion"&&o.hp<u.ad*1.2?170:0);
    if(sc<bs){bs=sc;b=o}
  }
  return b;
}
function autoAim(i){
  const u=G.player,s=u.def.skills[i],R=s.kind==="self"?400:Math.min(s.range||500,1000);
  if(s.kind==="self")return{x:u.x,y:u.y};
  const c=nearestFoeChamp(u,u.x,u.y,R+80);
  if(c)return{x:c.x+c.vx*.15,y:c.y+c.vy*.15};
  const o=nearestAny(u,u.x,u.y,R);
  if(o)return{x:o.x,y:o.y};
  const v=G.lastMove||{x:Math.cos(u.face),y:Math.sin(u.face)};
  return{x:u.x+v.x*R,y:u.y+v.y*R};
}
function bindSkill(b,i){
  let st=null;
  b.addEventListener("pointerdown",e=>{
    e.preventDefault();if(!G.player||paused)return;
    const how=e.pointerType==="mouse"?"mouse":"touch";
    st={x:e.clientX,y:e.clientY,id:e.pointerId};b.setPointerCapture(e.pointerId);
    G.aim={i,how,drag:null,cancel:false};if(how==="touch")showCancel(true);
    if(how==="mouse")$("tip").hidden=true;
  });
  b.addEventListener("pointermove",e=>{
    if(!st||e.pointerId!==st.id||!G.aim)return;const dx=e.clientX-st.x,dy=e.clientY-st.y,d=hyp(dx,dy);
    if(G.aim.how==="mouse"){if(d>14)G.aim.drag=true;return}
    if(d>14)G.aim.drag={x:dx/d,y:dy/d,k:clamp((d-14)/110,.05,1)};else G.aim.drag=null;
    G.aim.cancel=overCancel(e);$("cancel").classList.toggle("hot",G.aim.cancel);
  });
  b.addEventListener("pointerup",e=>{if(!st||e.pointerId!==st.id)return;st=null;if(G.aim&&G.aim.i===i){if(G.aim.how==="touch")G.aim.cancel=overCancel(e);commitAim()}});
  b.addEventListener("pointercancel",()=>{st=null;cancelAim()});
  b.addEventListener("pointerenter",()=>{if(!TOUCH&&G.player&&!G.aim){const s=G.player.def.skills[i];$("tip").textContent=`${s.name} · 대기 ${s.cd}초 · 마나 ${s.mp} · ${s.desc} (누른 채 지도로 끌면 직접 조준)`;$("tip").hidden=false;noteT=0}});
  b.addEventListener("pointerleave",()=>{if(!TOUCH)$("tip").hidden=true});
}
// 조이스틱
(function(){
  const j=$("joy"),k=$("joyK");let id=null;
  const upd=e=>{const r=j.getBoundingClientRect(),dx=e.clientX-r.left-r.width/2,dy=e.clientY-r.top-r.height/2,d=hyp(dx,dy),m=Math.min(d,48);
    k.style.transform=`translate(${(d?dx/d:0)*m}px,${(d?dy/d:0)*m}px)`;
