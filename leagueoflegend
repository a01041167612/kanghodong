    const base=t.kind==="minion"?t.maxHp*.42:u.ad*(1+G.t/900);
    G.projs.push({k:"hom",x:u.x,y:u.y-(u.kind==="tower"?70:60),tgt:t,speed:1100,dmg:base,type:"true",src:u,color:u.team===0?"#8fc4ff":"#ff9a88"});
    if(u.seen[0]&&dist(u,G.cam)<900)sfx("tower",.25);
    return;
  }
  const dtype=u.def?u.def.dmgType:"phys";
  let amt=u.def&&u.def.dmgType==="mag"?u.ad+.25*u.ap:u.ad,crit=false;
  if(u.key==="kai"){u.atkN=(u.atkN||0)+1;if(u.atkN%4===0){amt*=1.6;crit=true}}
  if(u.empower){if(u.empower.t>G.t){amt*=u.empower.m;crit=true}u.empower=null}
  if(u.range>120){
    G.projs.push({k:"hom",x:u.x,y:u.y,tgt:t,speed:u.kind==="champ"?1300:900,dmg:amt,type:dtype,src:u,crit,color:crit?"#fff3a0":u.def?u.def.color:(u.team===0?"#bcdcff":"#ffc0b4")});
  }else{
    if(u.kind==="champ"||dist(u,G.cam)<900)G.fx.push({k:"slash",x:u.x,y:u.y-(u.kind==="champ"?26:u.kind==="mob"?10:12),a:u.face,r:u.kind==="champ"?u.r+u.range:u.kind==="mob"?u.r+40:30,c:u.def?u.def.color:u.kind==="mob"?"#e8d98a":TC[u.team],t:.2,T:.2});
    hit(u,t,amt,dtype,crit?"crit":undefined);
