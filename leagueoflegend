#joy{display:none;position:absolute;left:max(18px,env(safe-area-inset-left,0px));bottom:max(20px,env(safe-area-inset-bottom,0px));width:136px;height:136px;border-radius:50%;border:2px solid rgba(238,240,220,.45);background:rgba(16,32,31,.32);touch-action:none}
