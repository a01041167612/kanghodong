<script>
"use strict";
/* ───────── 기본 유틸 ───────── */
const $=id=>document.getElementById(id);
const MS=1.75,WORLD=3000*MS,TEAM_ALLY=0,TEAM_FOE=1,NEUTRAL=2;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const hyp=Math.hypot;
const dist=(a,b)=>hyp(a.x-b.x,a.y-b.y);
const edge=(a,b)=>dist(a,b)-a.r-b.r;
function segDist(px,py,ax,ay,bx,by){const dx=bx-ax,dy=by-ay,l=dx*dx+dy*dy||1;const t=clamp(((px-ax)*dx+(py-ay)*dy)/l,0,1);return hyp(px-ax-dx*t,py-ay-dy*t)}
function seeded(s){return()=>{s|=0;s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const TOUCH=matchMedia("(pointer:coarse)").matches;
if(TOUCH)$("app").classList.add("touch");
const REDUCED=matchMedia("(prefers-reduced-motion:reduce)").matches;

/* ───────── 지도 ───────── */
const P=(x,y)=>({x:x*MS,y:y*MS}),PA=a=>a.map(([x,y])=>[x*MS,y*MS]);
const NEX=[P(330,2670),P(2670,330)];
const FOUNT=[P(150,2850),P(2850,150)];
const TOP_BASE=(function(){
  const pts=[[330,2670],[315,2300],[300,1500],[300,820]];
  for(let i=0;i<=8;i++){const a=Math.PI-i/8*Math.PI/2,r=520;pts.push([820+Math.cos(a)*r,820-Math.sin(a)*r])}
  pts.push([1500,300],[2300,315],[2670,330]);
  return PA(pts);
})();
const LANES=[
 TOP_BASE,
 PA([[330,2670],[2670,330]]),
 TOP_BASE.map(([x,y])=>[WORLD-x,WORLD-y]).reverse()
];
const LANE_NAMES=["탑","미드","봇"];
const TIERS=[["o",.39],["i",.19]];
/* 정글 캠프: 기준 좌표(3000 기준), 종류. 맞은편 팀 정글은 점대칭으로 만든다 */
const CAMP_TYPES={
  wolves:{name:"늑대 무리",look:"wolf",pack:[[0,0,1],[-55,35,.7],[55,35,.7]],hp:620,ad:26,r:26,col:"#9aa0a6",gold:40,xp:70},
  birds:{name:"부리새 떼",look:"bird",pack:[[0,0,1],[-50,-25,.65],[50,-25,.65],[0,45,.65]],hp:460,ad:22,r:22,col:"#d0905a",gold:30,xp:55},
  beast:{name:"숲 짐승",look:"spike",pack:[[0,0,1]],hp:1150,ad:36,r:30,col:"#8a8a58",gold:80,xp:130},
  rock:{name:"바위 정령",look:"rock",pack:[[0,0,1],[48,28,.6]],hp:1400,ad:40,r:36,col:"#8c8676",gold:90,xp:150},
  red:{name:"붉은 수호자",look:"guard",pack:[[0,0,1]],hp:2000,ad:55,r:42,col:"#e0553a",gold:110,xp:210,buff:"red"},
  blue:{name:"푸른 수호자",look:"guard",pack:[[0,0,1]],hp:2000,ad:50,r:42,col:"#3a8ae0",gold:110,xp:210,buff:"blue"},
  drake:{name:"강의 수호수",look:"spike",pack:[[0,0,1]],hp:3600,ad:95,r:56,col:"#3fa7a0",gold:150,xp:320,obj:"drake"},
  golem:{name:"고대 골렘",look:"rock",pack:[[0,0,1]],hp:5200,ad:95,r:60,col:"#a68a5a",gold:150,xp:320,obj:"golem"}
