const TICK=1/30;let acc=0,last=0,pressT=0,endShown=false;
function frame(now){
  requestAnimationFrame(frame);
  const dt=Math.min(.1,(now-last)/1000||0);last=now;
  if(G.shake)G.shake=Math.max(0,G.shake-dt*30);
  if(G.attract&&G.over)newGame({attract:true});
  if(!paused&&!G.over){
    acc+=dt;
    while(acc>=TICK){step(TICK);acc-=TICK}
    if(mouseDown&&G.player&&!G.player.dead){pressT-=dt;if(pressT<=0){pressT=.16;const t=G.player.target;if(!t)setDest(G.player,G.mouse.x,G.mouse.y)}}
  }
  // 카메라
  const c=G.cam;
  if(G.player){
    const g=c.peek||G.player;c.x+=(g.x-c.x)*Math.min(1,dt*(c.peek?12:8));c.y+=(g.y-c.y)*Math.min(1,dt*(c.peek?12:8));
    G.mouse.x=(G.mouse.sx-VW/2)/zoom+c.x;G.mouse.y=(G.mouse.sy-VH/2)/zoom+c.y;
  }else{
    G.camT-=dt;
    if(G.camT<=0||!G.camGoal||G.camGoal.dead){G.camT=9;const live=G.champs.filter(u=>!u.dead&&u.hp<u.maxHp*.95);G.camGoal=live[Math.random()*live.length|0]||G.champs[1+Math.random()*3|0]}
    c.x+=(G.camGoal.x-c.x)*Math.min(1,dt*.9);c.y+=(G.camGoal.y-c.y)*Math.min(1,dt*.9);
  }
  const hw=G.player?0:VW/zoom/2,hh=G.player?0:VH/zoom/2;
  c.x=hw*2>=WORLD?WORLD/2:clamp(c.x,hw,WORLD-hw);c.y=hh*2>=WORLD?WORLD/2:clamp(c.y,hh,WORLD-hh);
  render();
  updateHud(dt);
  if(G.over&&G.player&&$("score").hidden){showScore(true)}
}
