/* ───────── 이동 ───────── */
function setDest(u,x,y,force){
  x=clamp(x,30,WORLD-30);y=clamp(y,30,WORLD-30);
  if(!force&&u.dest&&hyp(u.dest.x-x,u.dest.y-y)<30&&u.wps&&u.wps.length)return;
  u.dest={x,y};u.wps=findPath(u.x,u.y,x,y);
}
function stepToward(u,tx,ty,dt){
  const d=hyp(tx-u.x,ty-u.y);if(d<1)return true;
  const st=Math.min(d,u.speed*dt);u.x+=(tx-u.x)/d*st;u.y+=(ty-u.y)/d*st;u.face=Math.atan2(ty-u.y,tx-u.x);
  settle(u);return st>=d-1;
}
function followPath(u,dt){
  if(!u.wps||!u.wps.length)return;
  const w=u.wps[0];
  if(hyp(w.x-u.x,w.y-u.y)<14||stepToward(u,w.x,w.y,dt)){u.wps.shift();if(!u.wps.length)u.dest=null}
}
function chase(u,t,dt){
