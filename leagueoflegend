function spawnWave(){
  G.wave++;
  const m=1+G.t/360;
  for(const tm of [0,1])for(const lane of [0,1,2]){
    const inner=G.towers.find(t=>t.team!==tm&&t.lane===lane&&t.tier==="i");
    let boost=(inner&&inner.dead?1.45:1)*(G.buffs.golem[tm]>G.t?1.35:1);
    const list=["m","m","m","r","r"];if(G.wave%3===0)list.push("s");
    list.forEach((k,i)=>{
      const S={m:{hp:340,ad:19,range:55,gold:22,xpv:38,r:24},r:{hp:230,ad:29,range:300,gold:16,xpv:28,r:21},s:{hp:800,ad:60,range:330,gold:48,xpv:70,r:31}}[k];
      const u=mk("minion",tm,NEX[tm].x,NEX[tm].y,{mt:k,lane,s:0,delay:i*.55,r:S.r,hp:S.hp*m*boost,maxHp:S.hp*m*boost,ad:S.ad*m*boost,as:.85,range:S.range,speed:260,gold:S.gold,xpv:S.xpv,armor:k==="s"?35:12,mr:k==="s"?35:8,retarget:0,offs:(i-2.5)*11});
      u.path=PATHS[tm][lane];G.units.push(u);
    });
  }
}
function updateMinion(u,dt){
  if(u.delay>0){u.delay-=dt;u.x=-999;u.y=-999;if(u.delay<=0){u.x=NEX[u.team].x;u.y=NEX[u.team].y}return}
  u.retarget-=dt;
  if(u.retarget<=0){
    u.retarget=.4;
    if(!canHit(u,u.target)||edge(u,u.target)>u.range+120){
      let best=null,bd=1e9;
      for(const o of G.units){
        if(o.dead||o.team===u.team||o.invuln||o.team===NEUTRAL||o.delay>0)continue;
        const d=edge(u,o);const lim=Math.max(u.range+90,330);if(d>lim)continue;
        const sc=d+(o.kind==="champ"?90:0);
        if(sc<bd){bd=sc;best=o}
      }
      u.target=best;
    }
  }
  if(hasBuff(u,"stun"))return;
  const t=u.target;
  if(t&&canHit(u,t)){
    if(edge(u,t)<=u.range){if(u.atkCd<=0)basicAttack(u,t)}
    else if(!hasBuff(u,"root"))stepToward(u,t.x,t.y,dt*speedMul(u));
    return;
  }
  if(hasBuff(u,"root"))return;
  const len=pathLen(u.path);
  if(u.s<len-90){
    u.s=Math.max(u.s,arcOf(u.path,u.x,u.y));
    const p=pointAt(u.path,u.s+60);
    stepToward(u,p.x+u.offs*.4,p.y-u.offs*.4,dt*speedMul(u));
    u.s+=u.speed*dt*.0;
  }
}
const speedMul=u=>1-Math.min(.7,buffVal(u,"slow"));
function updateTower(u,dt){
  if(u.kind==="tower"||u.kind==="nexus"){
    const R=u.range+u.r;
    if(u.aggro&&G.t<u.aggroT&&!u.aggro.dead&&dist(u,u.aggro)<=R)u.target=u.aggro;
    else if(!canHit(u,u.target)||dist(u,u.target)>R+u.target.r){
      let best=null,bd=1e9;
      for(const o of G.units){
        if(o.dead||o.team===u.team||o.team===NEUTRAL||o.kind==="tower"||o.kind==="nexus"||o.delay>0)continue;
        const d=dist(u,o);if(d>R+o.r)continue;
        const sc=d+(o.kind==="champ"?1500:0);if(sc<bd){bd=sc;best=o}
      }
      u.target=best;
    }
    if(u.target&&u.atkCd<=0)basicAttack(u,u.target);
  }
}
function updateMobs(dt){
  for(const m of G.mobs){
    if(m.alive===0&&G.t>=m.respawn&&!m.spawned){
      const D=m.def,g=1+G.t/500,big=!!D.obj;m.units=[];m.spawned=true;
      for(const [dx,dy,k] of D.pack){
        const u=mk("mob",NEUTRAL,m.x+dx,m.y+dy,{m,hx:m.x+dx,hy:m.y+dy,name:D.name,r:D.r*(k<1?.75:1),hp:D.hp*k*g,maxHp:D.hp*k*g,ad:D.ad*(k<1?.7:1)*g,as:.8,range:(big?120:70),speed:300,armor:big?45:18,mr:big?45:18,gold:D.gold*k,xpv:D.xp*k,engaged:-99,lead:dx===0&&dy===0});
        m.units.push(u);G.units.push(u);
      }
      m.alive=m.units.length;
    }
    for(const u of m.units){
      if(u.dead)continue;
      const home=hyp(u.x-u.hx,u.y-u.hy);
      if(u.target&&(u.target.dead||G.t-u.engaged>5||hyp(u.target.x-m.x,u.target.y-m.y)>600))u.target=null;
      if(u.target){
        if(edge(u,u.target)<=u.range){if(u.atkCd<=0)basicAttack(u,u.target)}else stepToward(u,u.target.x,u.target.y,dt);
      }else{
        if(home>8)stepToward(u,u.hx,u.hy,dt*1.4);else u.face=Math.PI/2;
        u.hp=Math.min(u.maxHp,u.hp+u.maxHp*.12*dt);
      }
    }
  }
}
/* ───────── 봇 AI ───────── */
function towerDanger(u,x,y){
  for(const t of G.towers){
    if(t.dead||t.team===u.team)continue;
    if(hyp(t.x-x,t.y-y)<t.range+t.r+45){
      let cover=0;
      for(const m of G.units)if(m.kind==="minion"&&m.team===u.team&&!m.dead&&m.delay<=0&&dist(m,t)<t.range+20)cover++;
      if(cover<2||t.target===u)return t;
    }
  }
  const n=G.nexus[u.team===0?1:0];
  if(n&&hyp(n.x-x,n.y-y)<n.range+n.r+40){let cover=0;for(const m of G.units)if(m.kind==="minion"&&m.team===u.team&&!m.dead&&m.delay<=0&&dist(m,n)<n.range)cover++;if(cover<2||n.target===u)return n}
  if(hyp(FOUNT[u.team===0?1:0].x-x,FOUNT[u.team===0?1:0].y-y)<650)return n;
  return null;
}
function laneGoal(u){
  const lane=u.lane<0?1:u.lane,path=PATHS[u.team][lane];
  let front=0;
  for(const m of G.units)if(m.kind==="minion"&&m.team===u.team&&m.lane===lane&&!m.dead&&m.delay<=0&&m.s>front)front=m.s;
  for(const t of G.towers)if(t.team===u.team&&t.lane===lane&&!t.dead&&t.arc[u.team]>front)front=t.arc[u.team]-40;
  let s=front-110;
  for(const t of G.towers){
    if(t.team===u.team||t.lane!==lane||t.dead)continue;
    const ta=t.arc[u.team];if(ta<s+t.range+t.r+110){
      let cover=0;for(const m of G.units)if(m.kind==="minion"&&m.team===u.team&&!m.dead&&m.delay<=0&&dist(m,t)<t.range+20)cover++;
      if(cover<2)s=Math.min(s,ta-(t.range+t.r+110));
      break;
    }
  }
  const p=pointAt(path,Math.max(120,s));
  const seed=(u.id%5-2)*34;
  return{x:p.x+seed,y:p.y-seed};
}
function botThink(u){
  const diff=u.team===TEAM_FOE&&!G.attract?G.diff:DIFF.normal;
  const hpr=u.hp/u.maxHp;
  if(atFountain(u)){while(u.buyIdx<u.def.buy.length&&buy(u,u.def.buy[u.buyIdx]))u.buyIdx++}
  const foes=G.champs.filter(c=>!c.dead&&c.team!==u.team&&c.seen[u.team]&&dist(u,c)<1000);
  foes.sort((a,b)=>dist(u,a)-dist(u,b));
  const foe=foes[0]||null;
  const friends=G.champs.filter(c=>!c.dead&&c.team===u.team&&dist(u,c)<750).length;
  const danger=foes.filter(c=>dist(u,c)<750).length;

  if(hpr<.2&&foe&&u.scd[1]<=0&&dist(u,foe)<600)trySummon(u,1,u.x,u.y);

  // 복귀 판단
  const nextPrice=u.buyIdx<u.def.buy.length?ITEM[u.def.buy[u.buyIdx]].c:1e9;
  const wantsShop=u.gold>=nextPrice+250&&u.items.length<6;
  if(u.botState!=="retreat"&&(hpr<.27/diff.aggr||(u.mp<u.maxMp*.1&&hpr<.5)||(wantsShop&&!foe)))u.botState="retreat";
  if(u.botState==="retreat"){
    if(atFountain(u)&&hpr>.9){u.botState="lane"}
    else{
      u.target=null;
      if(foe&&dist(u,foe)<520){const sk=u.def.skills.findIndex((s,i)=>s.ai==="escape"&&u.rank[i]>0&&u.cd[i]<=0&&u.mp>=s.mp);if(sk>=0){const n=nd(foe,u);tryCast(u,sk,u.x+n.x*400,u.y+n.y*400)}}
      if(!foe&&!u.recall&&!atFountain(u)&&G.t-u.lastHit>3&&dist(u,FOUNT[u.team])>900)u.recall={t:5};
      if(!u.recall)setDest(u,FOUNT[u.team].x+40,FOUNT[u.team].y-40);
      return;
    }
  }
  if(u.recall)return;

  // 적 영웅과 교전
  let tgt=null;
  if(foe){
    const myPower=friends*(.5+hpr*.5);
    const foePower=danger*(.5+foe.hp/foe.maxHp*.5);
    const fair=(myPower*diff.aggr>=foePower*.8)||foe.hp/foe.maxHp<.25;
    const reach=u.range+u.r+foe.r+(u.def.range<120?300:90);
    const safe=!towerDanger(u,foe.x,foe.y)||foe.hp/foe.maxHp<.15;
    if(fair&&safe&&dist(u,foe)<Math.max(reach,600))tgt=foe;
    botSkills(u,foe,diff,fair);
    if(!fair&&dist(u,foe)<500&&danger>friends){const n=nd(foe,u);setDest(u,u.x+n.x*300,u.y+n.y*300);u.target=null;return}
  }else botSkills(u,null,diff,false);
  if(tgt){u.target=tgt;return}

  // 정글러 목표
  if(u.lane<0){
    let best=null,bd=1e9;
    for(const m of G.mobs){
      const mu=m.units.find(o=>!o.dead);if(!mu)continue;
      if(m.obj&&(u.lvl<8||hpr<.7))continue;
      if(hyp(m.x-u.x,m.y-u.y)>2600)continue;
      const d=hyp(m.x-u.x,m.y-u.y)+(m.obj?-300:0)+(m.def.buff?-250:0)+(((m.x+m.y)>WORLD)!==(u.team===0)?400:0);if(d<bd){bd=d;best=m}
    }
    const threatened=G.champs.find(c=>!c.dead&&c.team===u.team&&c!==u&&dist(u,c)<1300&&G.champs.some(f=>!f.dead&&f.team!==u.team&&f.seen[u.team]&&dist(f,c)<520&&f.hp/f.maxHp<.65));
    if(threatened&&u.lvl>=3){const f=G.champs.filter(f=>!f.dead&&f.team!==u.team&&f.seen[u.team]).sort((a,b)=>dist(a,threatened)-dist(b,threatened))[0];if(f&&!towerDanger(u,f.x,f.y)){u.target=f;return}}
    if(best&&hpr>.45){u.target=best.units.find(o=>!o.dead);return}
  }

  // 미니언 · 구조물 공격
  let best=null,bs=1e9;
  for(const o of G.units){
    if(o.dead||o.team===u.team||o.invuln||o.team===NEUTRAL||o.delay>0)continue;
    const d=dist(u,o);if(d>(o.kind==="minion"?640:820))continue;
    if(o.kind==="champ")continue;
    if(towerDanger(u,o.x,o.y)&&o.kind==="minion"&&edge(u,o)>u.range)continue;
    if(o.kind!=="minion"&&towerDanger(u,o.x,o.y)&&o.kind!=="tower"&&o.kind!=="nexus")continue;
    if((o.kind==="tower"||o.kind==="nexus")&&towerDanger(u,o.x,o.y))continue;
    const sc=o.kind==="minion"?(o.hp<u.ad*1.3?-500:o.hp/o.maxHp*200+d*.2):(o.kind==="nexus"?-300:-100);
    if(sc<bs){bs=sc;best=o}
  }
  if(best&&u.lane>=0||best&&u.lane<0&&hpr>.5){u.target=best;return}
  u.target=null;
  const g=laneGoal(u);
  if(hyp(g.x-u.x,g.y-u.y)>70)setDest(u,g.x,g.y);else{u.dest=null;u.wps=null}
}
function botSkills(u,foe,diff,fair){
  const skills=u.def.skills;
  const ready=i=>u.rank[i]>0&&u.cd[i]<=0&&u.mp>=skills[i].mp;
  const lead=(s,t)=>{const tm=s.speed?dist(u,t)/s.speed:(s.ai==="ground"?.7:.1);const noise=(1-diff.aim)*130;return{x:t.x+t.vx*tm*diff.aim+(Math.random()-.5)*noise,y:t.y+t.vy*tm*diff.aim+(Math.random()-.5)*noise}};
  const minionsNear=r=>{let n=0;for(const m of G.units)if(m.kind==="minion"&&m.team!==u.team&&!m.dead&&m.delay<=0&&dist(u,m)<r)n++;return n};
  for(let i=0;i<4;i++){
    if(!ready(i))continue;
    const s=skills[i];
    if(s.ai==="shot"&&foe&&dist(u,foe)<s.range-40){const p=lead(s,foe);if(clearLine(u.x,u.y,p.x,p.y)){tryCast(u,i,p.x,p.y);return}}
    else if(s.ai==="aoeSelf"&&((foe&&dist(u,foe)<s.r)||minionsNear(s.r)>=3&&u.mp>u.maxMp*.45)){tryCast(u,i,u.x,u.y);return}
