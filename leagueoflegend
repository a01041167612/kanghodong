#dead{position:absolute;top:30%;left:50%;transform:translateX(-50%);font:400 26px var(--display);text-align:center;color:var(--foe);text-shadow:0 2px 0 #000}

/* 모달 */
.modal{position:absolute;inset:0;display:grid;place-items:center;background:rgba(8,16,16,.6);pointer-events:auto;touch-action:pan-y;
 padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:12px;overflow:auto}
.sheet{width:min(620px,100%);background:var(--ink);border:1px solid var(--line);border-top:4px solid var(--brass);padding:16px;display:grid;gap:11px;max-height:100%;overflow:auto;touch-action:pan-y}
.sheet h2{margin:0;font:400 28px var(--display)}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.x{background:var(--panel);border:1px solid var(--line);padding:6px 11px}
#items{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:6px}
.it{background:var(--panel);border:1px solid var(--line);padding:8px;text-align:left;display:grid;gap:2px;font-size:13px}
.it small{color:var(--muted)} .it span{color:var(--brass);font-weight:700;font-variant-numeric:tabular-nums}
.it:disabled{opacity:.45;cursor:not-allowed}
.tblw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
td,th{padding:5px 7px;text-align:left;border-bottom:1px solid var(--panel2);white-space:nowrap}
th{color:var(--muted);font-weight:500} tr.me td{color:var(--brass);font-weight:700}

/* 터치 */
.touch #joy{display:block}
.touch #bar{left:auto;right:max(14px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));transform:none;display:block;width:212px;height:208px}
.touch #stat{position:fixed;top:calc(max(8px,env(safe-area-inset-top,0px)) + 40px);left:max(16px,env(safe-area-inset-left,0px));width:142px;padding:5px}
.touch #inv{display:none}
.touch #skills{display:block}
.touch .sk{position:absolute;width:58px;height:58px;border-radius:50%}
.touch .sk.small{width:44px;height:44px}
.touch #atk{display:grid;position:absolute;right:0;bottom:0;width:84px;height:84px;border-radius:50%;background:color-mix(in srgb,var(--foe) 50%,var(--panel));border:2px solid var(--paper);place-items:center;font:400 18px var(--display);touch-action:none}
.touch #sk0{right:92px;bottom:0}.touch #sk1{right:78px;bottom:64px}.touch #sk2{right:26px;bottom:92px}.touch #sk3{right:150px;bottom:48px}
.touch #sk4{right:154px;bottom:0;}.touch #sk5{right:140px;bottom:112px}
.touch #side{position:fixed;left:max(16px,env(safe-area-inset-left,0px));bottom:calc(max(20px,env(safe-area-inset-bottom,0px)) + 142px);grid-auto-flow:row}
.touch #mm{top:calc(max(8px,env(safe-area-inset-top,0px)) + 40px);bottom:auto;width:112px;height:112px}
.touch #feed{top:calc(max(8px,env(safe-area-inset-top,0px)) + 158px);font-size:12px}
.touch #top{font-size:12px;gap:6px;padding:3px 8px}.touch #top b{font-size:17px}
.touch #tools{left:auto;right:max(16px,env(safe-area-inset-right,0px));top:calc(max(8px,env(safe-area-inset-top,0px)) + 158px);flex-direction:column}
.touch #tip{top:auto;bottom:calc(max(20px,env(safe-area-inset-bottom,0px)) + 210px);width:min(300px,60%);font-size:12px;left:50%}
@media (max-height:500px){.touch #pstat{display:none}.touch #side{left:calc(max(16px,env(safe-area-inset-left,0px)) + 150px);top:calc(max(8px,env(safe-area-inset-top,0px)) + 40px);bottom:auto}.touch #tools{right:calc(max(16px,env(safe-area-inset-right,0px)) + 120px);top:calc(max(8px,env(safe-area-inset-top,0px)) + 40px)}.touch #feed{top:calc(max(8px,env(safe-area-inset-top,0px)) + 40px);width:32%}.touch #tip{top:auto;bottom:12px;left:42%;width:220px}.touch #bar{height:190px}.touch #sk5{bottom:102px}}
@media (max-width:1000px){#inv{display:none}#stat{width:150px}}
