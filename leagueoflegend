for(let i=0;i<30*55;i++)step(TICK); // 첫 화면이 교전 중인 전장으로 열리도록 앞서 진행
{const c=G.champs.find(u=>u.lane===1);G.cam.x=c.x;G.cam.y=c.y}
requestAnimationFrame(frame);
setTimeout(()=>{bakeMap();$("start").disabled=false;$("start").textContent="전투 시작"},60);
window.__g={get G(){return G},step,TICK,newGame,startGame,castPlayer,command};
